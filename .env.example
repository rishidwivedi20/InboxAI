# Copy to .env.local and fill in.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by background jobs; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional, defaults to llama-3.1-8b-instant
GROQ_MODEL=

# NewsAPI (https://newsapi.org/register)
NEWS_API_KEY=

# Gmail SMTP (needs 2FA + an App Password: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Inngest. Not needed locally with `npx inngest-cli@latest dev`;
# required in production (Inngest dashboard -> your app -> keys).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
